{
	"name": "zipo",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc && vite build",
		"preview": "vite preview",
		"sync": "npx cap sync android",
		"android:dev": "ionic cap run android -l --external",
		"lint": "npm run eslint && npm run prettier:check",
		"eslint": "eslint .",
		"typecheck": "vue-tsc --noEmit",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{cjs,css,html,js,json,md,mjs,ts,vue,yaml,yml}": "prettier --write"
	},
	"dependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/app": "8.1.2",
		"@capacitor/core": "8.6.0",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/keyboard": "8.0.6",
		"@capacitor/status-bar": "8.0.4",
		"@ionic/vue": "^9.0.0",
		"@ionic/vue-router": "^9.0.0",
		"ionicons": "^8.1.0",
		"vue": "^3.5.0",
		"vue-router": "^5.0.0"
	},
	"devDependencies": {
		"@capacitor/cli": "8.6.0",
		"@eslint/js": "^10.0.1",
		"@ionic/eslint-config": "^0.5.0",
		"@ionic/prettier-config": "^4.0.0",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.0.0",
		"@vitejs/plugin-legacy": "^8.0.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.3.0",
		"eslint": "^10.13.0",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"terser": "^5.16.0",
		"typescript": "~5.9.0",
		"vite": "^8.0.0",
		"vitest": "~5.0.5",
		"vue-tsc": "^3.3.5"
	}
}
